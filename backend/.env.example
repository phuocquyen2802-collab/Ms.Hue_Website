PORT=5000
JWT_SECRET=change_this_to_a_random_secret_key
GEMINI_API_KEY=your_google_gemini_api_key_here
# Model soạn lộ trình/bài tập (cần chất lượng) và model cho trang Trợ lý AI (cần nhanh)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ---- Gửi email khôi phục mật khẩu (SMTP) ----
# Địa chỉ trang web, dùng để tạo đường dẫn trong email (không có / ở cuối)
APP_URL=https://mathinsigth-ai.work.gd
# Người gửi: phải là địa chỉ thuộc tên miền đã xác minh ở dịch vụ gửi mail
MAIL_FROM=MathInsight AI <no-reply@mathinsigth-ai.work.gd>
# Ví dụ dùng Resend (resend.com): SMTP_USER luôn là "resend", SMTP_PASS là API key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
