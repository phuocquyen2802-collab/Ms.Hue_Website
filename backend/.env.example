PORT=5000
JWT_SECRET=change_this_to_a_random_secret_key
GEMINI_API_KEY=your_google_gemini_api_key_here
# Model soạn lộ trình/bài tập (cần chất lượng) và model cho trang Trợ lý AI (cần nhanh)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ---- Gửi email khôi phục mật khẩu ----
# Địa chỉ trang web, dùng để tạo đường dẫn trong email (không có / ở cuối).
# Chạy thử trên máy cá nhân thì dùng http://localhost:5173
APP_URL=https://mathinsigth-ai.work.gd
# Người gửi: phải thuộc tên miền đã xác minh ở Resend (Domains -> Verified)
EMAIL_FROM="MathInsight AI <support@mathinsight-ai.luminexnet.top>"
# Resend (resend.com) -> API Keys -> Create API Key, bắt đầu bằng re_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Không dùng Resend API thì có thể gửi qua SMTP bất kỳ (bỏ trống RESEND_API_KEY):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
